  Height: 840
  Hide Left Dock: false
  Hide Right Dock: false
  Navigation 2:
    collapsed: false
  QMainWindow State: 
  RealsenseCamera:
    collapsed: false
  Selection:
    collapsed: false
  Selector:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1160
  X: 759
  Y: 35
